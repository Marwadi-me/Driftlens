# GitHub API Token (Optional for public repositories, recommended to avoid rate limits)
GITHUB_TOKEN=

# Open-Weight LLM Configuration (OpenAI-compatible server e.g. vLLM, Ollama, Together, Groq)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.together.xyz/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
